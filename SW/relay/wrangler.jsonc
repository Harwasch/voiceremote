{
  "name": "voiceremote-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "ADMISSION", "class_name": "Admission" },
      { "name": "WAKE", "class_name": "WakeProvider" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Admission", "WakeProvider"] }],
  "observability": { "enabled": false },
  "send_metrics": false
}
