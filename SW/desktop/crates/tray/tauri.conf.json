{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Receiver",
  "version": "0.1.0",
  "identifier": "org.voiceremote.receiver",
  "build": {
    "frontendDist": "ui",
    "features": [
      "gui"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice Receiver",
        "width": 580,
        "height": 790,
        "visible": false,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Voice Receiver destination",
        "url": "overlay.html",
        "width": 280,
        "height": 64,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Pair your iPhone and receive dictation securely",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
