        "ciphertext": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1500000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "not": {
            "pattern": "[^A-Za-z0-9+/=]"
          }
        },
        "block_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$",
          "not": {
            "pattern": "[^0-9a-f]"
          }
        },
        "epoch": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "account_id",
