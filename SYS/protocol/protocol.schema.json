{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiceremote.invalid/protocol/v1",
  "title": "VoiceRemote wire contract v1",
  "$ref": "#/$defs/InnerMessage",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix epoch milliseconds; safe in JavaScript."
    },
    "Counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1048576,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "not": {
        "pattern": "[^A-Za-z0-9+/=]"
      }
    },
    "PayloadHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]+$",
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "description": "SHA-256 of the immutable UTF-8 task preview bytes retained by trusted policy; JSON serialization is not canonicalized by this contract."
    },
    "Mode": {
      "type": "string",
      "enum": [
        "dictation",
        "ai_control"
      ]
    },
    "CaptureState": {
      "type": "string",
      "enum": [
        "off",
        "hold",
        "continuous"
      ]
    },
    "RiskClass": {
      "type": "string",
      "enum": [
        "read_display",
        "workspace_modify",
        "sensitive"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "receive_text",
        "open_resource",
        "delegate_task",
        "cancel_task",
        "external_send"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "queued",
        "dispatched",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "CandidateState": {
      "type": "string",
      "enum": [
        "suggested",
        "edited",
        "approved",
        "dismissed",
        "expired"
      ]
    },
    "ActivationKind": {
      "type": "string",
      "enum": [
        "ptt",
        "wake_word",
        "approval_tap"
      ]
    },
    "ApprovalCredentialClass": {
      "type": "string",
      "enum": [
        "scoped_grant",
        "user_presence",
        "biometric",
        "passcode"
      ]
    },
    "ToolCall": {
      "$ref": "https://voiceremote.invalid/tools/v1#/$defs/ToolCall"
    },
    "RelayCiphertext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ciphertext"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sender_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "ciphertext": {
          "$ref": "#/$defs/Base64"
        }
      },
      "required": [
        "kind",
        "account_id",
        "room_id",
        "sender_device_id",
        "ciphertext"
      ]
    },
    "RelayPresence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "presence"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sender_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "type": "string",
          "enum": [
            "online",
            "offline"
          ]
        }
      },
      "required": [
        "kind",
        "account_id",
        "room_id",
        "sender_device_id",
        "state"
      ]
    },
    "RelayWakeRegistration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wake_registration"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "sender_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "apns_wake_token": {
          "$ref": "#/$defs/Base64"
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        }
      },
      "required": [
        "kind",
        "account_id",
        "room_id",
        "sender_device_id",
        "apns_wake_token",
        "environment"
      ]
    },
    "RelayFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/RelayCiphertext"
        },
        {
          "$ref": "#/$defs/RelayPresence"
        },
        {
          "$ref": "#/$defs/RelayWakeRegistration"
        }
      ]
    },
    "PairingPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pairing"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "desktop_public_key": {
          "$ref": "#/$defs/Base64"
        },
        "one_use_token": {
          "$ref": "#/$defs/PairingToken"
        },
        "expires_at": {
          "$ref": "#/$defs/PairingExpiry"
        },
        "relay_room_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "account_id",
        "desktop_public_key",
        "one_use_token",
        "expires_at",
        "relay_room_id"
      ]
    },
    "DictationText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "dictation_text"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "segment_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "state": {
          "type": "string",
          "enum": [
            "partial",
            "committed"
          ]
        },
        "target_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "text": {
          "type": "string",
          "maxLength": 16384,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
          }
        },
        "preparation_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "account_id",
        "segment_id",
        "revision",
        "state",
        "target_device_id",
        "text"
      ]
    },
    "FocusReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "focus_report"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "text_field_focused": {
          "type": "boolean"
        },
        "last_activity_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "activity_age_ms": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "kind",
        "account_id",
        "device_id",
        "text_field_focused",
        "last_activity_at"
      ]
    },
    "DeviceInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "device_info"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "enum": [
            "ios",
            "windows",
            "linux",
            "remote"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "text_receiver",
            "agent",
            "both",
            "capture"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 256
        }
      },
      "required": [
        "kind",
        "account_id",
        "device_id",
        "display_name",
        "platform",
        "role",
        "capabilities"
      ]
    },
    "Revoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "revoke"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Identifier"
        },
        "revoked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "kind",
        "account_id",
        "device_id",
        "command_id",
        "idempotency_key",
        "revoked_at"
      ]
    },
    "TaskStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "task_status"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "denied",
            "unavailable",
            "error"
          ]
        }
      },
      "required": [
        "kind",
        "account_id",
        "command_id",
        "execution_state",
        "updated_at"
      ]
    },
    "CaptureSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "capture_segment"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capture_session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "iphone",
            "airpods",
            "desktop",
            "remote"
          ]
        },
        "source_clock": {
          "$ref": "#/$defs/Counter"
        },
        "receive_timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "partial_revision": {
          "$ref": "#/$defs/Counter"
        },
        "committed_segment_id": {
          "$ref": "#/$defs/Identifier"
        },
        "speaker_evidence": {
          "type": "string",
          "enum": [
            "unknown",
            "matched",
            "ambiguous"
          ]
        },
        "recording_consent_state": {
          "type": "string",
          "enum": [
            "unknown",
            "granted",
            "denied"
          ]
        },
        "segment_text": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "kind",
        "account_id",
        "capture_session_id",
        "source_id",
        "source_type",
        "source_clock",
        "receive_timestamp",
        "partial_revision",
        "committed_segment_id",
        "speaker_evidence",
        "recording_consent_state",
        "segment_text"
      ]
    },
    "CandidateAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "candidate_action"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "candidate_id": {
          "$ref": "#/$defs/Identifier"
        },
        "parent_capture_session": {
          "$ref": "#/$defs/Identifier"
        },
        "segment_span_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 256
        },
        "proposed_task_kind": {
          "$ref": "#/$defs/Capability"
        },
        "proposed_task": {
          "$ref": "#/$defs/ToolCall"
        },
        "proposed_payload_hash": {
          "$ref": "#/$defs/PayloadHash"
        },
        "destination_hint": {
          "$ref": "#/$defs/Identifier"
        },
        "origin_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "proposed_risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "suggestion_expiry": {
          "$ref": "#/$defs/Timestamp"
        },
        "card_visibility": {
          "type": "string",
          "enum": [
            "visible",
            "muted"
          ]
        },
        "candidate_state": {
          "$ref": "#/$defs/CandidateState"
        }
      },
      "required": [
        "kind",
        "account_id",
        "candidate_id",
        "parent_capture_session",
        "segment_span_ids",
        "proposed_task_kind",
        "proposed_task",
        "proposed_payload_hash",
        "origin_confidence",
        "proposed_risk_class",
        "suggestion_expiry",
        "card_visibility",
        "candidate_state"
      ]
    },
    "AuthorizedCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "authorized_command"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "candidate_id": {
          "$ref": "#/$defs/Identifier"
        },
        "immutable_task_payload": {
          "$ref": "#/$defs/ToolCall"
        },
        "payload_hash": {
          "$ref": "#/$defs/PayloadHash"
        },
        "source_tier": {
          "type": "string",
          "enum": [
            "inferred",
            "explicit"
          ]
        },
        "activation_kind": {
          "$ref": "#/$defs/ActivationKind"
        },
        "authenticated_actor": {
          "$ref": "#/$defs/Identifier"
        },
        "approval_credential_class": {
          "$ref": "#/$defs/ApprovalCredentialClass"
        },
        "approval_event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "policy_version": {
          "$ref": "#/$defs/Identifier"
        },
        "granted_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "destination_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider_session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "denied",
            "unavailable",
            "error"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "kind",
        "account_id",
        "command_id",
        "candidate_id",
        "immutable_task_payload",
        "payload_hash",
        "source_tier",
        "activation_kind",
        "authenticated_actor",
        "approval_credential_class",
        "risk_class",
        "policy_version",
        "granted_scope_id",
        "destination_id",
        "idempotency_key",
        "execution_state",
        "created_at",
        "updated_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_tier": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "required": [
              "approval_event_id"
            ],
            "properties": {
              "activation_kind": {
                "const": "approval_tap"
              },
              "approval_credential_class": {
                "type": "string",
                "enum": [
                  "user_presence",
                  "biometric",
                  "passcode"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "activation_kind": {
                "const": "approval_tap"
              }
            }
          },
          "then": {
            "required": [
              "approval_event_id"
            ],
            "properties": {
              "approval_credential_class": {
                "type": "string",
                "enum": [
                  "user_presence",
                  "biometric",
                  "passcode"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk_class": {
                "const": "sensitive"
              }
            }
          },
          "then": {
            "required": [
              "approval_event_id"
            ],
            "properties": {
              "approval_credential_class": {
                "type": "string",
                "enum": [
                  "biometric",
                  "passcode"
                ]
              }
            }
          }
        }
      ]
    },
    "AuditEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "audit_entry"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "audit_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authenticated_actor": {
          "$ref": "#/$defs/Identifier"
        },
        "event": {
          "type": "string",
          "enum": [
            "approved",
            "denied",
            "queued",
            "dispatched",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "revoked"
          ]
        },
        "payload_hash": {
          "$ref": "#/$defs/PayloadHash"
        },
        "policy_version": {
          "$ref": "#/$defs/Identifier"
        },
        "recorded_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "approval_event_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "account_id",
        "audit_id",
        "command_id",
        "authenticated_actor",
        "event",
        "payload_hash",
        "policy_version",
        "recorded_at"
      ]
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "grant"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "grant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authenticated_actor": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "risk_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "kind",
        "account_id",
        "grant_id",
        "authenticated_actor",
        "device_id",
        "project_id",
        "capability",
        "risk_class",
        "expires_at"
      ]
    },
    "ModeState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "mode"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        }
      },
      "required": [
        "kind",
        "account_id",
        "device_id",
        "mode"
      ]
    },
    "CaptureStateReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "capture_state"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capture_state": {
          "$ref": "#/$defs/CaptureState"
        },
        "listening": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "account_id",
        "device_id",
        "capture_state"
      ]
    },
    "InnerMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/DictationText"
        },
        {
          "$ref": "#/$defs/FocusReport"
        },
        {
          "$ref": "#/$defs/DeviceInfo"
        },
        {
          "$ref": "#/$defs/Revoke"
        },
        {
          "$ref": "#/$defs/TaskStatus"
        },
        {
          "$ref": "#/$defs/CaptureSegment"
        },
        {
          "$ref": "#/$defs/CandidateAction"
        },
        {
          "$ref": "#/$defs/AuthorizedCommand"
        },
        {
          "$ref": "#/$defs/AuditEntry"
        },
        {
          "$ref": "#/$defs/Grant"
        },
        {
          "$ref": "#/$defs/ModeState"
        },
        {
          "$ref": "#/$defs/CaptureStateReport"
        },
        {
          "$ref": "#/$defs/TargetPrepare"
        },
        {
          "$ref": "#/$defs/TargetReady"
        },
        {
          "$ref": "#/$defs/DictationOutcome"
        },
        {
          "$ref": "#/$defs/DictationQuery"
        },
        {
          "$ref": "#/$defs/CaptureControl"
        },
        {
          "$ref": "#/$defs/CaptureControlResult"
        }
      ]
    },
    "PairingToken": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "not": {
        "pattern": "[^A-Za-z0-9+/=]"
      },
      "description": "32-byte single-use bootstrap token; not a lasting credential."
    },
    "PairingExpiry": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Positive Unix epoch milliseconds. Enrollment additionally checks now < expires_at <= now + 120000 using trusted time."
    },
    "TargetPrepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "target_prepare"
        },
        "account_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
